{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": ".cml-build",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/lib/cml/contracts.ts",
    "src/lib/cml/runtime.ts",
    "src/lib/cml/adaptive.ts",
    "src/lib/cml/evidence.ts",
    "src/lib/cml/authoring.ts",
    "src/lib/cml/kernels.ts",
    "src/lib/cml/examples/**/*.ts",
    "src/lib/cml/index.ts",
    "tests/cml-selftest.ts"
  ]
}
