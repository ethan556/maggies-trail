 "steps": [
  {
   "id": "c1",
   "kind": "concept",
   "figure": "radical-factor",
   "body": "Multiply radicals by multiplying the radicands: √a · √b = √(ab). So √2 · √3 = √6. When the product is a perfect square, it becomes a whole number: √2 · √8 = √16 = 4."
  },
  {
   "id": "i1",
   "kind": "interactive",
   "body": "Multiply to a whole number.",
   "widget": {
    "type": "numeric",
    "prompt": "√2 · √8 = ?",
    "answer": 4,
    "tolerance": 0,
    "commonErrors": [
     {
      "value": 10,
      "feedback": "Multiply the radicands, don't add them: √(2 · 8) = √16 = 4."
     },
     {
      "value": 16,
      "feedback": "√16 isn't 16 — take the root: √16 = 4."
     }
    ],
    "fallbackFeedback": "√2 · √8 = √16 = 4."
   },
   "predict": {
    "prompt": "√2 · √8 — two irrational numbers. Their product will be…",
    "options": [
     {
      "id": "whole",
      "label": "A whole number — the radicands merge"
     },
     {
      "id": "irr",
      "label": "Irrational — irrationals stay irrational"
     },
     {
      "id": "sixteen",
      "label": "Exactly 16"
     }
    ],
    "outcomeId": "whole",
    "reveal": "The product rule merges the insides: √2 · √8 = √16 = 4 — the root of the product, not the product itself. Two irrationals can land square on a whole number whenever their radicands multiply to a perfect square."
   }
  },
