        "prompt": "10³ × 10⁻⁵ = 10^____ (just the exponent)",
        "answer": -2,
        "tolerance": 0,
        "commonErrors": [
          {
            "value": 15,
            "feedback": "That multiplies the exponents instead of adding — the rule is always ADD when multiplying: 3+(−5)=−2."
          },
          {
            "value": 8,
            "feedback": "That treats −5 as +5 — keep the sign: 3+(−5)=−2, not 3+5=8."
          }
        ],
        "fallbackFeedback": "10³ × 10⁻⁵ = 10^(3+(−5)) = 10⁻²."
      }
    },
    {
      "id": "k2",
      "kind": "check",
