{
  "id": "sp-04-03",
  "slug": "probability-models-in-real-situations",
  "title": "Probability Models in Real Situations",
  "courseId": "sampling-and-probability",
  "chapterId": "ch4-probability-models-and-compound-events",
  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "compound-event-tree",
      "body": "Real situations often need both tools: count the full sample space with the counting principle, then find a compound event's probability by multiplying."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Count outcomes for a real situation.",
      "widget": {
        "type": "compoundEventLab",
        "prompt": "A restaurant has 6 shirts and 5 pants for staff uniforms. How many total outfits are possible?",
        "mode": "count",
        "stages": [
          {
            "label": "Shirts",
            "outcomes": [
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6"
            ],
            "favourable": []
          },
          {
            "label": "Pants",
            "outcomes": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5"
            ],
            "favourable": []
          }
        ],
        "choices": [
          {
            "id": "correct",
            "label": "30",
            "count": 30,
            "feedback": "Yes — 6 × 5 = 30 outfits."
          },
          {
            "id": "trap-1",
            "label": "11",
            "count": 11,
            "feedback": "That adds 6+5 instead of multiplying. Total outfits = 6 × 5 = 30."
          },
          {
            "id": "trap-2",
            "label": "6",
            "count": 6,
            "feedback": "That's just the shirts. Multiply by the 5 pants too: 6 × 5 = 30."
          }
        ],
        "fallbackFeedback": "6 shirts × 5 pants = 30 outfits.",
        "successFeedback": "Yes — 6 × 5 = 30 outfits."
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "A compound-event probability in a game context.",
      "conceptTag": "sp-realworld-prob",
      "explanationVariants": [
        "P(heads)=1/2, P(even)=1/2; multiply: 1/4.",
        "For independent events, multiply the individual probabilities."
      ],
      "widget": {
        "type": "compoundEventLab",
        "prompt": "What is the probability of flipping heads and rolling an even number?",
        "mode": "probability",
        "stages": [
          {
            "label": "Coin",
            "outcomes": [
              "H",
              "T"
            ],
            "favourable": [
              0
            ]
          },
          {
            "label": "Die",
            "outcomes": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "favourable": [
              1,
              3,
              5
            ]
          }
        ],
        "choices": [
          {
            "id": "a",
            "label": "1/4",
            "num": 1,
            "den": 4,
            "feedback": "Yes — 1/2 × 1/2 = 1/4."
          },
          {
            "id": "b",
            "label": "1/2",
            "num": 1,
            "den": 2,
            "feedback": "That's just one event. Multiply both: 1/4."
          },
          {
            "id": "c",
            "label": "1/12",
            "num": 1,
            "den": 12,
            "feedback": "Multiply the probabilities directly: 1/4."
          }
        ],
        "fallbackFeedback": "Yes — 1/2 × 1/2 = 1/4.",
        "successFeedback": "Yes — 1/2 × 1/2 = 1/4."
      },
      "variant": {
        "gen": "g7-sp-compound-model",
        "form": "spCompoundBasic"
      }
    },
    {
      "id": "c2",
      "kind": "concept",
      "body": "A game with repeated identical trials (like flipping a coin several times) still uses the counting principle — the same 2 choices, repeated.",
      "figure": "compound-event-tree"
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "Count outcomes for a game with repeated flips.",
      "widget": {
        "type": "compoundEventLab",
        "prompt": "Flipping a coin 4 times: how many total outcomes are there?",
        "mode": "count",
        "stages": [
          {
            "label": "Flip 1",
            "outcomes": [
              "H",
              "T"
            ],
            "favourable": []
          },
          {
            "label": "Flip 2",
            "outcomes": [
              "H",
              "T"
            ],
            "favourable": []
          },
          {
            "label": "Flip 3",
            "outcomes": [
              "H",
              "T"
            ],
            "favourable": []
          },
          {
            "label": "Flip 4",
            "outcomes": [
              "H",
              "T"
            ],
            "favourable": []
          }
        ],
        "choices": [
          {
            "id": "correct",
            "label": "16",
            "count": 16,
            "feedback": "Yes — 2 × 2 × 2 × 2 = 16 ordered outcomes."
          },
          {
            "id": "trap-1",
            "label": "8",
            "count": 8,
            "feedback": "That adds 2+2+2+2 instead of multiplying. Total outcomes = 2×2×2×2 = 16."
          },
          {
            "id": "trap-2",
            "label": "4",
            "count": 4,
            "feedback": "That's just the number of flips. Multiply the 2 outcomes for each flip: 2×2×2×2=16."
          }
        ],
        "fallbackFeedback": "2 × 2 × 2 × 2 = 16 total outcomes.",
        "successFeedback": "Yes — 2 × 2 × 2 × 2 = 16 ordered outcomes."
      }
    },
    {
      "id": "c3",
      "kind": "concept",
      "body": "Whatever the situation — outfits, games, dice — the same two tools apply: multiply choices for the sample space, multiply probabilities for a compound event.",
