{
  "id": "kc-02-03",
  "slug": "order-the-numbers",
  "title": "Order the Numbers",
  "courseId": "counting-to-20-k",
  "chapterId": "ch2-comparing",
  "minutes": 6,
  "readingProfile": "early",
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "body": "Numbers have an **order**: 1, 2, 3, 4 … Each number is one more than the one before.",
      "figure": "number-track"
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Put them in order.",
      "widget": {
        "type": "dragOrder",
        "prompt": "Drag the numbers into counting order, smallest first.",
        "items": [
          {
            "id": "n1",
            "label": "5"
          },
          {
            "id": "n2",
            "label": "2"
          },
          {
            "id": "n3",
            "label": "7"
          }
        ],
        "correctOrder": [
          "n2",
          "n1",
          "n3"
        ],
        "misorderFeedback": [
          {
            "first": "n3",
            "second": "n2",
            "feedback": "7 placed before 2 is backward — the smallest, 2, goes first."
          }
        ],
        "missFeedback": "Smallest first: 2, then 5, then 7.",
        "successFeedback": "Yes — 2, 5, 7. Counting order!"
      }
    },
    {
      "id": "c2",
      "kind": "concept",
      "body": "To order numbers, find the **smallest** first. Then the next. The biggest goes last.",
      "figure": "kc-order"
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "Order three numbers.",
      "conceptTag": "kc-order-numbers",
      "explanationVariants": [
        "Smallest first: 1, then 4, then 9.",
        "Counting order puts 1 before 4 before 9."
      ],
      "widget": {
        "type": "dragOrder",
        "prompt": "Drag into counting order, smallest first.",
        "items": [
          {
            "id": "n1",
            "label": "9"
          },
          {
            "id": "n2",
            "label": "1"
          },
          {
            "id": "n3",
            "label": "4"
          }
        ],
        "correctOrder": [
          "n2",
          "n3",
          "n1"
        ],
        "misorderFeedback": [
          {
            "first": "n1",
            "second": "n2",
            "feedback": "9 before 1 is biggest-first — the smallest, 1, leads."
          }
        ],
        "missFeedback": "Find the smallest (1), then the next (4), then 9.",
        "successFeedback": "Yes — 1, 4, 9!"
      },
      "variant": {
        "gen": "g0-counting",
        "form": "countOrderDrag"
      }
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "The missing number.",
      "widget": {
        "type": "numberLinePlace",
        "min": 0,
        "max": 10,
        "target": 6,
        "step": 1,
        "tickStep": 1,
        "start": 0,
        "prompt": "Counting goes 4, 5, ?, 7. Slide the marker to where the missing number lives on the line.",
        "commonPlacements": [
          {
            "value": 8,
            "feedback": "8 sits AFTER 7, but the missing number comes before it — it belongs in the gap between 5 and 7."
          },
          {
            "value": 5,
            "feedback": "5 is already there, just before the gap. The missing number is the very next one."
          },
          {
            "value": 3,
            "feedback": "3 comes before 4, so it is behind where the counting has already reached. The gap is between 5 and 7."
          }
        ],
        "successFeedback": "6 — and the line shows why it could not be anything else: it is the one spot with 5 on its left and 7 on its right. Counting order is a position on the line, not a fact to recall.",
        "lowFeedback": "Too far left — the marker is below 5, but the missing number comes after 5.",
        "highFeedback": "Too far right — the marker is past 7, but the missing number comes before 7."
      }
    },
    {
      "id": "k2",
      "kind": "check",
      "body": "Between two numbers.",
      "conceptTag": "kc-order-numbers",
      "explanationVariants": [
        "Counting 7, 8, 9 — the number between 7 and 9 is 8.",
        "8 sits right between 7 and 9."
      ],
      "widget": {
        "type": "mcq",
        "prompt": "Which number comes between 7 and 9?",
        "options": [
          {
            "id": "a",
            "label": "8",
            "correct": true,
            "feedback": "Yes — 7, 8, 9."
          },
          {
            "id": "b",
            "label": "6",
            "correct": false,
            "feedback": "6 comes BEFORE 7. Between 7 and 9 is 8."
          },
          {
            "id": "c",
            "label": "10",
            "correct": false,
            "feedback": "10 comes after 9. Between 7 and 9 is 8."
          },
          {
            "id": "d",
            "label": "7",
            "correct": false,
            "feedback": "7 is an end. The middle number is 8."
          }
        ]
      },
      "variant": {
        "gen": "g0-counting",
        "form": "countBetweenMcq"
      }
    },
    {
      "id": "k3",
      "kind": "check",
      "body": "Use zero as the boundary.",
      "conceptTag": "kc-order-numbers",
      "explanationVariants": [
        "Zero is the smallest — order: 0, 3, 8.",
        "0 starts the count: 0, then 3, then 8."
      ],
      "widget": {
        "type": "dragOrder",
        "prompt": "Drag 0, 3, and 8 into order. Start with the number that means none.",
        "items": [
          {
            "id": "n1",
            "label": "8"
          },
          {
            "id": "n2",
            "label": "0"
          },
          {
            "id": "n3",
            "label": "3"
          }
        ],
        "correctOrder": [
          "n2",
          "n3",
          "n1"
        ],
        "misorderFeedback": [
          {
            "first": "n3",
            "second": "n2",
            "feedback": "3 before 0 skips zero — 0 is the smallest and goes first."
          }
        ],
        "missFeedback": "Zero means none — it comes before everything: 0, 3, 8.",
        "successFeedback": "Yes — 0, 3, 8. Zero leads the way!"
      },
      "variant": {
        "gen": "g0-counting",
        "form": "countOrderDrag"
      }
    },
