    {
      "id": "c2",
      "kind": "concept",
      "body": "Not every real table is proportional — a taxi fare with a flat starting fee, for instance, breaks the pattern because of that fixed extra amount.",
      "figure": "pr-flat-start"
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "A fare table.",
      "widget": {
        "type": "proportionalReasoningLab",
        "task": "testProportional",
        "answerMode": "choice",
        "prompt": "A table has pairs (2, 6), (3, 10), (5, 15). Is this proportional?",
        "xLabel": "x",
        "yLabel": "y",
        "series": [
          {
            "id": "table",
            "label": "table",
            "pairs": [
              [
                2,
                6
              ],
              [
                3,
                10
              ],
              [
                5,
                15
              ]
            ]
          }
        ],
        "requiredExplorations": 3,
        "successFeedback": "Yes — 6/2=3 and 15/5=3, but 10/3 isn't 3. Not proportional.",
        "explorationFeedback": "Inspect at least 3 proportional relationships before checking.",
        "fallbackFeedback": "Choose the conclusion supported by the normalized ratios.",
        "tolerance": 0,
        "choices": [
          {
            "id": "a",
            "label": "No, the middle ratio doesn't match",
            "feedback": "Yes — 6/2=3 and 15/5=3, but 10/3 isn't 3. Not proportional.",
            "claim": "proportional:no"
          },
          {
            "id": "b",
            "label": "Yes",
            "feedback": "Check every ratio: 10/3 breaks the pattern of 3. Not proportional.",
            "claim": "misconception:b"
          },
          {
            "id": "c",
            "label": "Can't tell",
            "feedback": "Computing the ratios tells you: 10/3 doesn't match, so not proportional.",
            "claim": "misconception:c"
          }
        ],
        "numericErrors": [],
        "targetSeriesId": "table"
      }
    },
    {
      "id": "c3",
      "kind": "concept",
      "body": "Once you've confirmed a table IS proportional, its constant of proportionality lets you predict any new value — a powerful shortcut for real problems.",
      "figure": "proportionality-test"
    },
    {
      "id": "i3",
      "kind": "interactive",
      "body": "Predict a new value.",
      "widget": {
        "type": "proportionalReasoningLab",
        "task": "predictOutput",
        "answerMode": "numeric",
        "prompt": "A table has pairs (3, 9), (5, 15). Using the constant of proportionality, what is y when x = 7?",
        "xLabel": "x",
        "yLabel": "y",
        "series": [
          {
            "id": "table",
            "label": "table",
            "pairs": [
              [
                3,
                9
              ],
              [
                5,
                15
              ]
            ]
          }
        ],
        "requiredExplorations": 2,
        "successFeedback": "k = 9/3 = 3, so y = 3 × 7 = 21.",
        "explorationFeedback": "Inspect at least 2 proportional relationships before checking.",
        "fallbackFeedback": "k = 9/3 = 3, so y = 3 × 7 = 21.",
        "tolerance": 0,
        "choices": [],
        "numericErrors": [
          {
            "value": 10,
            "feedback": "That adds instead of multiplying. Find k=3 first, then y = 3 × 7 = 21."
