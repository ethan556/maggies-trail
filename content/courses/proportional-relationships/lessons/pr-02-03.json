    {
      "id": "c2",
      "kind": "concept",
      "body": "Not every real table is proportional — a taxi fare with a flat starting fee, for instance, breaks the pattern because of that fixed extra amount.",
      "figure": "pr-flat-start"
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "A fare table.",
      "widget": {
        "type": "proportionalReasoningLab",
        "task": "testProportional",
        "answerMode": "choice",
        "prompt": "A table has pairs (6, 18), (8, 25), (10, 30). Is this proportional?",
        "xLabel": "x",
        "yLabel": "y",
        "series": [
          {
            "id": "table",
            "label": "table",
            "pairs": [
              [
                6,
                18
              ],
              [
                8,
                25
              ],
              [
                10,
                30
              ]
            ]
          }
        ],
        "requiredExplorations": 3,
        "successFeedback": "Yes — 18/6=3 and 30/10=3, but 25/8 isn't 3. Not proportional.",
        "explorationFeedback": "Inspect at least 3 proportional relationships before checking.",
        "fallbackFeedback": "Choose the conclusion supported by the normalized ratios.",
        "tolerance": 0,
        "choices": [
          {
            "id": "a",
            "label": "No, the middle ratio doesn't match",
            "feedback": "Yes — 18/6=3 and 30/10=3, but 25/8 isn't 3. Not proportional.",
            "claim": "proportional:no"
          },
          {
            "id": "b",
            "label": "Yes",
            "feedback": "Check every ratio: 25/8 breaks the pattern of 3. Not proportional.",
            "claim": "misconception:b"
          },
          {
            "id": "c",
            "label": "Can't tell",
            "feedback": "Computing the ratios tells you: 25/8 doesn't match, so not proportional.",
            "claim": "misconception:c"
          }
        ],
        "numericErrors": [],
        "targetSeriesId": "table"
      }
