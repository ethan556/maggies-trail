    {
      "id": "c3",
      "kind": "concept",
      "body": "Once you've confirmed a table IS proportional, its constant of proportionality lets you predict any new value — a powerful shortcut for real problems.",
      "figure": "proportionality-test"
    },
    {
      "id": "i3",
      "kind": "interactive",
      "body": "Predict a new value.",
      "widget": {
        "type": "proportionalReasoningLab",
        "task": "predictOutput",
        "answerMode": "numeric",
        "prompt": "A table has pairs (2, 14), (4, 28). Using the constant of proportionality, what is y when x = 5?",
        "xLabel": "x",
        "yLabel": "y",
        "series": [
          {
            "id": "table",
            "label": "table",
            "pairs": [
              [
                2,
                14
              ],
              [
                4,
                28
              ]
