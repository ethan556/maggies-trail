  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "sign-rule-table",
      "body": "Combining like terms works the same with negative coefficients — add the coefficients using the signed-number rules you already know. -3x + 5x: different signs, so 5-3=2, keep positive: 2x."
    },
    {
      "id": "e1",
      "kind": "interactive",
      "body": "A long tile is x; a small tile is 1. A positive and a negative tile of the same kind cancel — so combining like terms is just cancelling pairs.",
      "widget": {
        "type": "algebraTiles",
        "prompt": "Build −3x + 5x with tiles and read what's left.",
        "targetX": 2,
        "targetConst": 0,
        "maxTiles": 8,
        "xStart": 0,
        "constStart": 0,
        "successFeedback": "2x — three negative x-tiles cancel three positives, and 2 positive x-tiles survive.",
        "xFeedback": "The x-tiles aren't right yet. −3x and +5x cancel in pairs, leaving 2x.",
        "constFeedback": "The x-tiles are right, but this expression has no constant — clear the unit tiles."
      },
      "predict": {
        "prompt": "−3x + 5x — after the tiles cancel, will the leftovers be x-tiles or number-tiles?",
        "options": [
          {
            "id": "xtiles",
            "label": "x-tiles"
          },
          {
            "id": "numbers",
            "label": "Number-tiles"
          },
          {
            "id": "nothing",
            "label": "Nothing is left"
          }
        ],
        "outcomeId": "xtiles",
        "reveal": "Opposite x-tiles cancel in pairs — three negatives eat three positives, leaving two x-tiles standing and no plain numbers at all."
      },
      "conceptTag": "tse-combine-negative",
