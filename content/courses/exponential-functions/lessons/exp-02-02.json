  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "exp-curve-decay",
      "body": "Decay models shrink by a fixed factor. A substance that halves each hour from 8000 is V(x) = 8000 · (1/2)ˣ, where x is hours. Each step multiplies by 1/2, so the amount falls toward zero."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "After two hours.",
      "widget": {
        "type": "expLogExplore",
        "mode": "exponential",
        "x": 2,
        "targetBase": 0.5,
        "startBase": 1.5,
        "showMirror": false,
        "prompt": "V(x) = 8000·bˣ halves each hour. Slide the base until b² reads 0.25.",
        "successFeedback": "Base 0.5, so b² = 0.25 and V(2) = 8000 × 0.25 = 2000. A base below 1 is decay, and two halvings leave a quarter — not half of a half taken away, but half OF a half.",
        "lowFeedback": "b² is below 0.25, so this decays faster than halving. Raise the base toward 0.5.",
        "highFeedback": "b² is above 0.25 — slower than halving. Lower the base toward 0.5."
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "Three half-steps.",
      "conceptTag": "exp-decay-model",
      "explanationVariants": [
        "Halve three times: 640 → 320 → 160 → 80.",
        "A(3) = 640 · (1/2)³ = 640/8 = 80."
      ],
      "widget": {
        "type": "exactNumberLab",
        "prompt": "A drug halves each period: A(x) = 640 · (1/2)^x. What is A(3)?",
        "task": "approximationEvaluate",
        "values": [],
