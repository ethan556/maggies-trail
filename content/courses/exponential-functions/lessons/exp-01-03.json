  "title": "The Constant Ratio",
  "courseId": "exponential-functions",
  "chapterId": "ch1-growth-and-decay",
  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "exp-curve-growth",
      "body": "In an exponential table, consecutive outputs share a **constant ratio**. Divide any term by the one before it to find the base b. For the sequence 3, 6, 12, 24: 6/3 = 12/6 = 24/12 = 2, so b = 2."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "The base IS the constant ratio.",
      "widget": {
        "type": "expLogExplore",
        "mode": "exponential",
        "x": 2,
        "targetBase": 3,
        "startBase": 2,
        "showMirror": false,
        "prompt": "A table triples at every step. Slide the base until b² lands on the ring at 9.",
        "successFeedback": "Base 3: every step multiplies by 3, so two steps give 3 × 3 = 9. The base is not just a number in the formula — it is the constant ratio between consecutive outputs.",
        "lowFeedback": "b² is below 9, so the step ratio is under 3. Raise the base.",
        "highFeedback": "b² is above 9 — the outputs are multiplying by more than 3 each step."
      },
      "conceptTag": "exp-ratio",
      "cml": {
        "stage": "construct",
        "flagship": false,
        "kernel": "covariation",
        "actionGoal": "Manipulate the model and track how it represents ratio.",
        "invariants": [
          "The manipulated model and the mathematical relationship for ratio must stay consistent."
        ],
        "misconceptions": [
          "Changing a visible feature without preserving the relationship that defines ratio."
        ],
        "representations": [
          "graph",
          "symbolic"
        ],
        "translationFrom": "graph",
        "translationTo": "symbolic",
        "fadeLevel": 0,
        "transferFamily": "exponential-functions:exp-ratio",
        "delayed": true,
        "counterfactualPrompt": "What change would make the model stop representing the same mathematical relationship?"
      }
    },
    {
