  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "exp-curve-growth",
      "body": "Real growth is exponential when a quantity multiplies by a fixed factor each period. A colony that triples yearly from 200 is modeled by P(x) = 200 · 3ˣ, where x is the number of years. Evaluate the model to project forward."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Project two years out.",
      "widget": {
        "type": "expLogExplore",
        "mode": "exponential",
        "x": 2,
        "targetBase": 3,
        "startBase": 1.5,
        "showMirror": false,
        "prompt": "P(x) = 200·bˣ. Slide the base until b² reads 9 — the factor a tripling colony needs.",
        "successFeedback": "Base 3, so b² = 9 and P(2) = 200·9 = 1800. The base IS the growth factor: tripling means multiplying by 3 once per year, and two years compounds it to 9.",
        "lowFeedback": "b² is still under 9 — a colony growing this slowly is not tripling. Raise the base.",
        "highFeedback": "b² has passed 9, so this colony more than triples each year. Lower the base."
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "A doubling model.",
      "conceptTag": "exp-growth-model",
      "explanationVariants": [
        "2³ = 8, then 500 · 8 = 4000.",
        "A(3) = 500 · 2³ = 500 · 8 = 4000."
      ],
      "widget": {
        "type": "exactNumberLab",
        "prompt": "Money doubles each period: A(x) = 500 · 2^x. What is A(3)?",
        "task": "approximationEvaluate",
        "values": [],
        "approxConstants": [
          {
            "id": "a",
            "label": "the start amount a",
            "value": 500
          },
          {
            "id": "b",
            "label": "the base b (one factor per step)",
            "value": 2
          }
        ],
        "approxFormula": {
          "op": "multiply",
          "left": {
            "op": "multiply",
            "left": {
              "op": "multiply",
              "left": {
                "op": "const",
                "id": "a"
              },
              "right": {
                "op": "const",
                "id": "b"
              }
            },
            "right": {
              "op": "const",
              "id": "b"
            }
          },
          "right": {
            "op": "const",
            "id": "b"
          }
        },
        "approxRound": 0,
        "answerMode": "numeric",
        "tolerance": 0,
        "numericErrors": [
          {
            "value": 1500,
            "feedback": "Doubling three times means ×2³ = ×8: 500 · 8 = 4000, not 500 · 3."
          },
          {
            "value": 2000,
            "feedback": "That's A(2). One more doubling gives A(3) = 4000."
          }
        ],
        "choices": [],
        "authoredStages": [],
        "requiredStageKeys": [
          "approx:a",
