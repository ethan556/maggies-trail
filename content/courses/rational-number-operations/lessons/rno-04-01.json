{
  "id": "rno-04-01",
  "slug": "multiplying-and-dividing-signed-fractions",
  "title": "Multiplying and Dividing Signed Fractions",
  "courseId": "rational-number-operations",
  "chapterId": "ch4-operations-with-rational-numbers",
  "minutes": 10,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "sign-rule-table",
      "body": "The same sign rule extends to fractions: same signs give a positive result, different signs give a negative result. -1/2 × 2/3: different signs, so negative: -1/3."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Multiply signed fractions.",
      "widget": {
        "type": "signedFractionLab",
        "prompt": "-1/2 × 2/3 = ?",
        "operation": "multiply",
        "left": {
          "sign": -1,
          "num": 1,
          "den": 2
        },
        "right": {
          "sign": 1,
          "num": 2,
          "den": 3
        },
        "form": "any",
        "choices": [
          {
            "id": "a",
            "label": "-1/3",
            "sign": -1,
            "num": 1,
            "den": 3,
            "path": "correct",
            "feedback": "Yes — different signs give a negative result, and 1/2 × 2/3 = 1/3."
          },
          {
            "id": "b",
            "label": "1/3",
            "sign": 1,
            "num": 1,
            "den": 3,
            "path": "wrongSign",
            "feedback": "The signs are different (one negative, one positive), so the result must be negative: -1/3."
          },
          {
            "id": "c",
            "label": "-1/6",
            "sign": -1,
            "num": 1,
            "den": 6,
            "path": "magnitudeError",
            "feedback": "Check the multiplication: 1×2=2 over 2×3=6, which simplifies to 1/3, not 1/6."
          }
        ],
        "fallbackFeedback": "Check the signs, multiply the numerators and denominators, then simplify.",
        "successFeedback": "Yes — different signs give a negative result, and 1/2 × 2/3 = 1/3."
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "Multiply two negative fractions.",
      "conceptTag": "rno-frac-multiply-sign",
      "explanationVariants": [
        "Same signs (both negative) give a positive result: -3/4 × -1/2 = 3/8.",
        "Two negative fractions multiply to a positive."
      ],
      "widget": {
        "type": "signedFractionLab",
        "prompt": "-3/4 × -1/2 = ?",
        "operation": "multiply",
        "left": {
          "sign": -1,
          "num": 3,
          "den": 4
        },
        "right": {
          "sign": -1,
          "num": 1,
          "den": 2
        },
        "form": "any",
        "choices": [
          {
            "id": "correct",
            "label": "3/8",
            "sign": 1,
            "num": 3,
            "den": 8,
            "path": "correct",
            "feedback": "Yes — same signs give a positive result, and 3/4 × 1/2 = 3/8."
          },
          {
            "id": "sign",
            "label": "-3/8",
            "sign": -1,
            "num": 3,
            "den": 8,
            "path": "wrongSign",
            "feedback": "Both fractions are negative (same sign), so the result is positive: 3/8."
          },
          {
            "id": "magnitude",
            "label": "3/6",
            "sign": 1,
            "num": 3,
            "den": 6,
            "path": "magnitudeError",
            "feedback": "Check the multiplication: 3×1=3 over 4×2=8, giving 3/8, not 3/6."
          }
        ],
        "fallbackFeedback": "Multiply tops (3×1) and bottoms (4×2), then set the sign: same signs give positive.",
        "successFeedback": "Yes — same signs give a positive result, and 3/4 × 1/2 = 3/8."
      },
      "variant": {
        "gen": "frac-sign-ops"
      }
    },
    {
      "id": "c2",
      "kind": "concept",
      "body": "Dividing signed fractions follows the same rule — check the signs, then divide the magnitudes using flip-and-multiply.",
      "figure": "sign-rule-table"
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "Divide signed fractions.",
      "widget": {
        "type": "signedFractionLab",
        "prompt": "-3/4 ÷ 1/2 = ?",
        "operation": "divide",
        "left": {
          "sign": -1,
          "num": 3,
          "den": 4
        },
        "right": {
          "sign": 1,
          "num": 1,
          "den": 2
        },
        "form": "any",
        "choices": [
          {
            "id": "a",
            "label": "-3/2",
            "sign": -1,
            "num": 3,
            "den": 2,
            "path": "correct",
            "feedback": "Yes — different signs give a negative result, and 3/4 ÷ 1/2 = 3/4 × 2 = 3/2."
          },
          {
            "id": "b",
            "label": "3/2",
            "sign": 1,
            "num": 3,
            "den": 2,
            "path": "wrongSign",
            "feedback": "The signs are different (one negative, one positive), so the result must be negative: -3/2."
          },
          {
            "id": "c",
            "label": "-3/8",
            "sign": -1,
            "num": 3,
            "den": 8,
            "path": "keptDivisor",
            "feedback": "That multiplies instead of flipping and multiplying. 3/4 ÷ 1/2 = 3/4 × 2 = 3/2, so -3/2."
          }
        ],
        "fallbackFeedback": "Check the signs, flip the divisor, and multiply.",
        "successFeedback": "Yes — different signs give a negative result, and 3/4 ÷ 1/2 = 3/4 × 2 = 3/2."
      }
    },
    {
      "id": "c3",
      "kind": "concept",
      "body": "Watch for opposite signs hiding in a mixed expression — always check both fractions' signs before deciding whether the result is positive or negative.",
      "figure": "sign-rule-table"
    },
