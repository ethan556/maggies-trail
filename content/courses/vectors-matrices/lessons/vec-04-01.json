 "minutes": 10,
 "steps": [
  {
   "id": "c1",
   "kind": "concept",
   "body": "A **2×2 matrix** is a square of four numbers, [[a, b], [c, d]]. Add matrices entry by entry, and scale by multiplying every entry. The real power is the **matrix-vector product**, which sends a vector to a new vector:\n\n[[a, b], [c, d]]·⟨x, y⟩ = ⟨ax + by, cx + dy⟩.",
   "figure": "vec-det-area"
  },
  {
   "id": "i1",
   "kind": "interactive",
   "body": "Apply a matrix to a vector.",
   "widget": {
    "type": "numeric",
    "prompt": "Compute [[2, 0], [0, 3]]·⟨1, 1⟩. Enter the y-component.",
    "answer": 3,
    "tolerance": 0,
    "commonErrors": [
     {
      "value": 1,
      "feedback": "The y-component is c·x + d·y = 0·1 + 3·1 = 3 (you may have kept the input's 1)."
     },
     {
      "value": 2,
      "feedback": "2 is the x-component (2·1 + 0·1). The y-component is 0·1 + 3·1 = 3."
     }
    ],
    "fallbackFeedback": "y = 0·1 + 3·1 = 3 (the result is ⟨2, 3⟩)."
   }
  },
  {
   "id": "k1",
   "kind": "check",
   "body": "A full product.",
   "conceptTag": "vec-matrix-arith",
   "explanationVariants": [
    "[[1, 2], [3, 4]]·⟨1, 1⟩ = ⟨1·1 + 2·1, 3·1 + 4·1⟩ = ⟨3, 7⟩.",
    "Row by row: top row dotted with ⟨1,1⟩ is 3, bottom row is 7."
   ],
   "widget": {
    "type": "mcq",
    "prompt": "Compute [[1, 2], [3, 4]]·⟨1, 1⟩.",
    "options": [
     {
      "id": "o1",
      "label": "⟨3, 7⟩",
      "correct": true,
      "feedback": "Right — ⟨1+2, 3+4⟩ = ⟨3, 7⟩: each row dotted with the vector."
     },
     {
      "id": "o2",
      "label": "⟨1, 4⟩",
      "feedback": "Use the WHOLE row: top is 1·1 + 2·1 = 3, bottom is 3·1 + 4·1 = 7 → ⟨3, 7⟩."
     },
     {
      "id": "o3",
      "label": "⟨4, 6⟩",
      "feedback": "That adds columns. Each output is a ROW dotted with the vector: ⟨3, 7⟩."
     }
    ]
   },
   "variant": {
