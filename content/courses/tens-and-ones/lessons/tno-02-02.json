{
  "id": "tno-02-02",
  "slug": "reading-expanded-form",
  "title": "Reading Expanded Form",
  "courseId": "tens-and-ones",
  "chapterId": "ch2-expanded-form",
  "minutes": 9,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "expanded-form",
      "body": "Read expanded form by adding the parts. 40 + 6 = 46. The tens part tells you the left digit, and the ones part tells you the right digit."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Build what 40 + 6 names — the tray will catch digit-gluing.",
      "widget": {
        "type": "baseTenCompose",
        "prompt": "Build the number 40 + 6 names.",
        "target": 46,
        "requireStandard": true,
        "maxHundreds": 4,
        "maxTens": 9,
        "maxOnes": 9,
        "commonBuilds": [
          {
            "hundreds": 4,
            "tens": 0,
            "ones": 6,
            "feedback": "That builds 406 — the digits got glued side by side. 40 is 4 TENS (4 rods), not 4 hundreds: 40 + 6 = 46."
          },
          {
            "hundreds": 0,
            "tens": 6,
            "ones": 4,
            "feedback": "That builds 64 — the parts swapped spots. The 40 is the tens part (4 rods) and the 6 is the ones part."
          }
        ],
        "missFeedback": "40 gives the rods (4 tens) and 6 gives the cubes: together they make 46.",
        "successFeedback": "4 rods and 6 cubes — 46. Expanded form just names each spot's worth out loud: 40 + 6."
      },
      "predict": {
        "prompt": "40 + 6 names a number. How many digits will it have?",
        "options": [
          {
            "id": "three",
            "label": "Three digits"
          },
          {
            "id": "two",
            "label": "Two digits"
          },
          {
            "id": "depends",
            "label": "It depends on the order"
          }
        ],
        "outcomeId": "two",
        "reveal": "40 + 6 = 46 — two digits. The 40 IS 4 tens, so it slides into the tens spot; gluing the digits side by side into 406 invents a hundreds spot that 40 + 6 never asked for."
      },
      "conceptTag": "tno-read-expanded",
      "cml": {
        "stage": "construct",
        "flagship": false,
        "kernel": "equivalence-transformation",
        "actionGoal": "Manipulate the model and track how it represents tno read expanded.",
        "invariants": [
          "The manipulated model and the mathematical relationship for tno read expanded must stay consistent."
        ],
        "misconceptions": [
          "Changing a visible feature without preserving the relationship that defines tno read expanded."
        ],
        "representations": [
          "concrete",
          "symbolic"
        ],
        "translationFrom": "concrete",
        "translationTo": "symbolic",
        "fadeLevel": 0,
        "transferFamily": "tens-and-ones:tno-read-expanded",
        "delayed": true,
        "counterfactualPrompt": "What change would make the model stop representing the same mathematical relationship?"
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "Another sum.",
      "conceptTag": "tno-read-expanded",
      "explanationVariants": [
        "50 + 3 = 53.",
        "Fifty and three make 53."
      ],
      "widget": {
        "type": "numeric",
        "prompt": "What number is 50 + 3?",
        "answer": 53,
        "tolerance": 0,
        "commonErrors": [
          {
            "value": 8,
            "feedback": "Don't add the digits 5 and 3. Add the values: 50 + 3 = 53."
          },
          {
            "value": 503,
            "feedback": "Don't write them side by side. 50 + 3 = 53."
          }
        ],
        "fallbackFeedback": "50 + 3 = 53."
      },
      "variant": {
        "gen": "g1-tens-ones",
        "form": "TnoReadExpandedNumeric"
      }
    },
    {
      "id": "c2",
      "kind": "concept",
      "body": "The tens part is always a multiple of ten. 80 + 5 = 85. If the ones part is 0, the number ends in 0: 60 + 0 = 60.",
      "figure": "tno-expanded-85"
    },
    {
      "id": "i2",
      "kind": "interactive",
      "body": "Tens plus ones.",
      "widget": {
        "type": "numeric",
        "prompt": "What number is 80 + 5?",
        "answer": 85,
        "tolerance": 0,
        "commonErrors": [
          {
            "value": 13,
            "feedback": "Don't add the digits 8 and 5. Add the values: 80 + 5 = 85."
          },
          {
            "value": 805,
            "feedback": "Don't write them side by side. 80 + 5 = 85."
          }
        ],
        "fallbackFeedback": "80 + 5 = 85."
      }
    },
    {
      "id": "c3",
      "kind": "concept",
      "body": "Expanded form can be written in either order, but the value is the same: 6 + 40 still makes 46. Add the tens and ones however they appear.",
      "figure": "tno-either-order"
    },
    {
      "id": "i3",
      "kind": "interactive",
      "body": "Ones part is zero.",
      "widget": {
        "type": "numeric",
        "prompt": "What number is 60 + 0?",
        "answer": 60,
        "tolerance": 0,
        "commonErrors": [
          {
            "value": 6,
            "feedback": "60 + 0 is still 60 — the 6 is in the tens place, worth 60."
          },
          {
            "value": 600,
            "feedback": "Don't write them side by side. 60 + 0 = 60."
          }
        ],
        "fallbackFeedback": "60 + 0 = 60."
      }
    },
