          "The manipulated model and the mathematical relationship for tno subtract tens must stay consistent."
        ],
        "misconceptions": [
          "Changing a visible feature without preserving the relationship that defines tno subtract tens."
        ],
        "representations": [
          "number-line",
          "symbolic"
        ],
        "translationFrom": "number-line",
        "translationTo": "symbolic",
        "fadeLevel": 0,
