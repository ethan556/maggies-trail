  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "base-ten-blocks",
      "body": "Subtracting tens takes whole tens away. 65 − 30 = 35: 6 tens minus 3 tens is 3 tens, and the 5 ones stay. The tens digit drops by the number of tens removed."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Hop backward on the number line.",
      "widget": {
        "type": "numberLineHop",
        "prompt": "Take 3 hops of 10, back from 65.",
        "min": 0,
        "max": 100,
        "start": 65,
        "hop": 10,
        "hops": 3,
        "direction": "back",
        "commonLandings": [
          {
            "value": 62,
            "feedback": "You hopped by 1 three times. Each hop takes away a full TEN: 65 → 55 → 45 → 35."
          },
          {
            "value": 45,
            "feedback": "That's 2 hops — taking away 30 needs three tens: one more hop back to 35."
          }
        ],
        "missFeedback": "Each hop takes away a full ten: 65 → 55 → 45 → 35.",
        "successFeedback": "35! Three hops of ten removed 30 — and the ones digit kept its 5 the whole ride."
      },
      "predict": {
        "prompt": "You'll take 30 from 65 with hops of ten. What happens to the ones digit, the 5?",
        "options": [
          {
            "id": "shrinks",
            "label": "It shrinks to 2"
          },
          {
            "id": "stays",
            "label": "It stays 5"
          },
          {
            "id": "gone",
            "label": "It becomes 0"
          }
        ],
        "outcomeId": "stays",
        "reveal": "Backward hops of ten slide you a whole rod at a time — 65 → 55 → 45 → 35 — and the 5 in the ones rides along untouched. Only subtracting ONES could change it."
      },
      "conceptTag": "tno-subtract-tens",
      "cml": {
        "stage": "construct",
