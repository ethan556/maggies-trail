            "id": "differ",
            "label": "Settle on two different heights"
          },
          {
            "id": "blow",
            "label": "Climb off the screen"
          }
        ],
        "outcomeId": "agree",
        "reveal": "Both sides close in on 4 — even though the point itself is missing. A limit only asks where the sides are HEADING, so it exists here despite the hole."
      },
      "cml": {
        "stage": "construct",
        "flagship": false,
