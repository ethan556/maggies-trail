  "title": "Distributing Radicals",
  "courseId": "radicals-and-exponents",
  "chapterId": "ch2-operations-with-radicals",
  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "body": "Distribute a radical over a sum just like a number: √2 · (√3 + √5) = √6 + √10. Multiply the outside radical into each term inside the parentheses, one at a time."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "Distribute across the sum.",
      "widget": {
        "type": "mcq",
        "prompt": "√2 · (√3 + √5) = ?",
        "options": [
          {
            "id": "a",
            "label": "√6 + √10",
            "correct": true,
            "feedback": "Yes — √2·√3 = √6 and √2·√5 = √10."
          },
          {
            "id": "b",
            "label": "√5 + √7",
            "feedback": "Multiply the radicands, don't add them: √2·√3 = √6, not √5."
          },
          {
            "id": "c",
            "label": "√6 + √7",
            "feedback": "The second product is √2·√5 = √10, not √7."
          }
        ]
      }
    },
    {
      "id": "k1",
      "kind": "check",
      "body": "A square product.",
      "conceptTag": "rad-distribute",
      "explanationVariants": [
        "√6 · √6 = √36 = 6.",
        "A radical times itself removes the root: √6 · √6 = 6."
      ],
      "widget": {
        "type": "exactNumberLab",
        "prompt": "√6 · √6 = ?",
        "task": "radicalProduct",
        "targetRadicand": 1,
        "values": [
          {
            "id": "left",
            "label": "√6 (factor 1)",
            "kind": "root",
            "radicand": 6,
            "coefficient": 1
          },
          {
            "id": "right",
            "label": "√6 (factor 2)",
            "kind": "root",
            "radicand": 6,
            "coefficient": 1
          }
        ],
        "answerMode": "numeric",
        "tolerance": 0,
        "numericErrors": [
          {
            "value": 36,
            "feedback": "√6 · √6 = √36, and √36 = 6 (take the root)."
          },
          {
            "value": 12,
            "feedback": "A radical times itself gives the radicand back: √6 · √6 = 6, not 6 + 6."
          }
        ],
        "choices": [],
        "authoredStages": [],
        "requiredStageKeys": [],
        "requiredExplorations": 1,
        "explorationFeedback": "Inspect the required exact-number states before checking.",
