{
  "id": "rad-04-03",
  "slug": "distance-between-points",
  "title": "Distance Between Points",
  "courseId": "radicals-and-exponents",
  "chapterId": "ch4-applications",
  "minutes": 11,
  "steps": [
    {
      "id": "c1",
      "kind": "concept",
      "figure": "right-triangle",
      "body": "The distance between two points is the hypotenuse of a right triangle: d = √((Δx)² + (Δy)²), where Δx and Δy are the horizontal and vertical gaps. From (0, 0) to (3, 4): d = √(9 + 16) = √25 = 5."
    },
    {
      "id": "i1",
      "kind": "interactive",
      "body": "The 3-4-5 triangle, on a grid.",
      "widget": {
        "type": "distanceGrid",
        "anchor": [
          0,
          0
        ],
        "targetPoint": [
          3,
          4
        ],
        "gridMin": 0,
        "gridMax": 8,
        "startX": 0,
        "startY": 0,
        "prompt": "Place the point that is exactly 5 units from the origin, with a run of 3.",
        "successFeedback": "(3, 4): 3² + 4² = 25, so the distance is √25 = 5. When the legs are not so friendly the answer stays a radical — but the picture never changes.",
        "wrongPointFeedback": "Not that one. You need a run of 3 and a rise that makes 3² + rise² = 25."
      },
      "predict": {
        "prompt": "Distance 5 from the origin with a run of 3: the rise must be…",
        "options": [
          {
            "id": "four",
            "label": "4 — since 3² + 4² = 25"
          },
          {
            "id": "two",
            "label": "2 — since 3 + 2 = 5"
          },
          {
            "id": "five",
            "label": "5"
          }
        ],
        "outcomeId": "four",
        "reveal": "Distance runs on squares: 5² − 3² = 16, so the rise is 4. The straight-line 5 splits into legs 3 and 4 — making the legs add to 5 (3 + 2) walks the streets, not the diagonal."
      },
      "cml": {
        "stage": "construct",
        "flagship": true,
        "kernel": "spatial-invariance",
        "actionGoal": "Construct horizontal and vertical displacement and connect the right triangle to radical distance.",
        "invariants": [
          "distance-nonnegative",
          "pythagorean-distance",
          "translation-preserves-distance"
        ],
        "misconceptions": [
          "manhattan-distance",
          "coordinate-sum"
        ],
        "representations": [
          "diagram",
          "graph",
          "table",
          "symbolic",
          "language"
        ],
        "translationFrom": "graph",
        "translationTo": "symbolic",
        "fadeLevel": 1,
        "transferFamily": "distance-between-arbitrary-coordinate-pairs",
        "delayed": true,
        "counterfactualPrompt": "Keep the distance 5 but change the horizontal run. Which other integer run-rise pair can preserve the same distance?",
        "explanation": {
          "prompt": "Why is the diagonal distance found from squares instead of by adding the run and rise?",
          "options": [
            {
              "id": "hypotenuse",
              "label": "The run and rise are perpendicular legs, so the diagonal is the hypotenuse governed by the Pythagorean theorem.",
              "correct": true,
              "feedback": "Exactly — perpendicular components combine through their squares."
            },
            {
              "id": "path",
              "label": "The diagonal follows the same path as walking horizontally and then vertically.",
              "correct": false,
              "feedback": "That sum measures a two-segment path, not the straight-line distance."
            }
          ]
        }
      },
      "conceptTag": "rad-distance"
    },
