 "steps": [
  {
   "id": "c1",
   "kind": "concept",
   "figure": "radical-factor",
   "body": "Multiply radicals by multiplying the radicands: √a · √b = √(ab). So √2 · √3 = √6. When the product is a perfect square, it becomes a whole number: √2 · √8 = √16 = 4."
  },
  {
   "id": "i1",
   "kind": "interactive",
   "body": "Build the radicand product as a rectangle, then take its square root.",
   "widget": {
    "type": "areaModel",
    "prompt": "Build a 2-by-8 rectangle to multiply the radicands in √2 · √8. Then read the square root of its 16 unit squares.",
    "targetArea": 16,
    "wMax": 8,
    "hMax": 8,
    "wStart": 2,
    "hStart": 2,
    "requireFactors": {
     "w": 2,
     "h": 8
    },
    "factorFeedback": "The area is 16, but the sides must show the original radicands 2 and 8. Build 2 × 8, not a different factor pair.",
    "successFeedback": "The 2-by-8 rectangle has area 16. Therefore √2 · √8 = √16 = 4.",
    "lowFeedback": "The rectangle has fewer than 16 squares. Keep one side at 2 and extend the other side to 8.",
    "highFeedback": "The rectangle has more than 16 squares. Return to the exact radicand product 2 × 8."
   },
   "predict": {
    "prompt": "Before building the rectangle, what kind of number is √2 · √8?",
    "options": [
     {
      "id": "whole",
      "label": "A whole number — 2 × 8 makes 16"
     },
     {
      "id": "irr",
      "label": "An irrational number — radicals never simplify"
     },
     {
      "id": "sixteen",
      "label": "Exactly 16 — stop before taking the root"
     }
    ],
    "outcomeId": "whole",
    "reveal": "The rectangle makes the product radicand visible: 2 × 8 = 16. Taking the remaining square root gives √16 = 4, so two irrational factors can produce a whole number."
   }
  },
