          },
          {
            "value": 12,
            "feedback": "Don't multiply 16 by 3/4. Take the fourth root (2), then cube it: 8."
          }
        ],
        "choices": [],
        "authoredStages": [],
        "requiredStageKeys": [],
        "requiredExplorations": 1,
        "explorationFeedback": "Inspect the required exact-number states before checking.",
        "fallbackFeedback": "16^(3/4) = (⁴√16)³ = 2³ = 8.",
        "successFeedback": "16^(3/4) = (⁴√16)³ = 2³ = 8."
      },
