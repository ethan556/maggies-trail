 "steps": [
  {
   "id": "c1",
   "kind": "concept",
   "figure": "like-radicals",
   "body": "**Like radicals** have the same radicand and combine like terms: 2√3 + 5√3 = 7√3. Add the coefficients and keep the radical. Unlike radicals — such as √2 + √3 — cannot be combined at all."
  },
  {
   "id": "i1",
   "kind": "interactive",
   "body": "Add like radicals.",
   "widget": {
    "type": "numeric",
    "prompt": "2√3 + 5√3 = a√3. What is a?",
    "answer": 7,
    "tolerance": 0,
    "commonErrors": [
     {
      "value": 10,
      "feedback": "Add the coefficients, don't multiply them: 2 + 5 = 7."
     },
     {
      "value": 3,
      "feedback": "3 is the radicand and stays put. Add the coefficients: 2 + 5 = 7."
     }
    ],
    "fallbackFeedback": "2 + 5 = 7, so 7√3."
   }
  },
  {
   "id": "k1",
   "kind": "check",
   "body": "Now subtract.",
   "conceptTag": "rad-like-terms",
   "explanationVariants": [
    "Subtract the coefficients: 6 − 2 = 4, keeping √5.",
    "6√5 − 2√5 = 4√5, so a = 4."
