 "steps": [
  {
   "id": "c1",
   "kind": "concept",
   "body": "The quadratic formula never needed the discriminant to be positive. For x² − 4x + 13 = 0: D = b² − 4ac = 16 − 52 = **−36**. Then √D = √(−36) = 6i, and x = (4 ± 6i)/2 = **2 ± 3i**. Same formula, new number system.",
   "figure": "discriminant-cases"
  },
  {
   "id": "i1",
   "kind": "interactive",
   "body": "Compute a negative discriminant.",
   "widget": {
    "type": "numeric",
    "prompt": "For x² − 4x + 13 = 0, what is the discriminant b² − 4ac?",
    "answer": -36,
    "tolerance": 0,
    "commonErrors": [
     {
      "value": 36,
      "feedback": "The size is right but 16 − 52 is NEGATIVE: −36 — that's exactly what makes the roots complex."
     },
     {
      "value": 68,
      "feedback": "That's 16 + 52 — the formula SUBTRACTS 4ac: 16 − 52 = −36."
     }
    ],
    "fallbackFeedback": "(−4)² − 4(1)(13) = 16 − 52 = −36."
   },
   "predict": {
    "prompt": "For x² − 4x + 13 = 0 you'll compute b² − 4ac. Its sign will be…",
    "options": [
     {
      "id": "neg",
      "label": "Negative — 16 can't beat 52"
     },
     {
      "id": "pos",
      "label": "Positive — b² is a square"
     },
     {
      "id": "zero",
      "label": "Exactly zero"
     }
    ],
    "outcomeId": "neg",
    "reveal": "b² = 16 but 4ac = 52, so the discriminant sinks to −36. Below zero means the parabola never touches the x-axis — the square root goes imaginary and both roots turn complex: x = 2 ± 3i."
   }
  },
  {
   "id": "c2",
   "kind": "concept",
   "body": "Finishing matters: x = (4 ± 6i)/2 divides **both parts** by 2, giving 2 ± 3i. Notice the answers are **conjugates** — same real part, opposite imaginary signs. Real-coefficient quadratics always deliver complex roots in conjugate pairs.",
   "figure": "cn-divide-both"
  },
