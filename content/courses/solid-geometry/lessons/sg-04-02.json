  "remedials": [
    {
      "conceptTag": "sg-composite-subtract",
      "concept": {
        "id": "rem-sg-composite-subtract-c",
        "kind": "concept",
        "body": "Hollow solids price by subtraction: volume = outer solid − removed solid. The tube: π(R² − r²)h — subtract the SQUARES, never square the difference ((R − r)² misprices the ring). Bores through blocks and carved cavities follow the same one-minus pattern, and bending a constant-section solid changes nothing (Cavalieri)."
      },
      "check": {
        "id": "rem-sg-composite-subtract-k",
        "kind": "check",
        "body": "One ring.",
        "conceptTag": "sg-composite-subtract",
        "explanationVariants": [
          "(R² − r²)h = (16 − 1)(3).",
          "15 × 3 = 45."
        ],
        "widget": {
          "type": "numeric",
          "prompt": "Tube: outer radius 4, inner radius 1, length 3. Coefficient of π = ?",
          "answer": 45,
          "tolerance": 0.01,
          "commonErrors": [
            {
              "value": 27,
              "feedback": "27 = (4−1)²(3) squares the difference — difference the squares: (16 − 1)(3) = 45."
            },
            {
              "value": 48,
              "feedback": "48 is the solid cylinder — the bore removes (1)(3) = 3: 45."
            }
          ],
          "fallbackFeedback": "(16 − 1)(3) = 45."
        }
      }
    }
  ],
