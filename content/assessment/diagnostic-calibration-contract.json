{
  "schemaVersion": 1,
  "instrumentVersion": "maggies-diagnostic-2026.1",
  "algorithmVersion": "ctt-2pl-bridge-1",
  "claimBoundary": "Item parameters remain provisional until real learner responses satisfy the declared sample, fit, uncertainty, fairness, and human-approval gates. Synthetic fixtures may test software but may never establish calibration.",
  "collection": {
    "explicitConsentRequired": true,
    "directIdentifiersCollected": [],
    "storedEvidence": [
      "item id",
      "administration order",
      "correctness",
      "selected option",
      "confidence",
      "response time",
      "provisional item parameters",
      "score uncertainty",
      "domain summary",
      "salted longitudinal study identifier in research exports"
    ],
    "excludedEvidence": [
      "learner name",
      "email address",
      "IP address",
      "prompt text",
      "free-text response"
    ]
  },
  "qualityGates": {
    "minimumUsableSessions": 500,
    "minimumResponsesPerItem": 200,
    "minimumResponsesPerItemForPromotion": 500,
    "minimumPointBiserial": 0.15,
    "maximumDifficultyStandardError": 0.35,
    "maximumDiscriminationStandardError": 0.45,
    "acceptablePValueRange": [
      0.05,
      0.95
    ],
    "minimumAnchorItems": 8,
    "maximumRapidResponseShare": 0.2,
    "humanApprovalRequired": true,
    "difReviewRequiredWhenGroupsAvailable": true
  },
  "outputs": [
    "classical item statistics",
    "2PL item parameter candidates",
    "Wald uncertainty intervals",
    "distractor frequencies",
    "quality flags",
    "optional DIF review",
    "anchor-based vertical scale link",
    "promotion-ready parameter manifest",
    "longitudinal growth estimates with uncertainty when repeated administrations exist"
  ]
}
